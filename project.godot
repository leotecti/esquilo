[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.12, 0.17, 0.14, 1)

[physics]

common/physics_ticks_per_second=60
2d/default_gravity=1200.0

[layer_names]

2d_physics/layer_1="World"
2d_physics/layer_2="Player"
2d_physics/layer_3="Enemy"
2d_physics/layer_4="PlayerHitbox"
2d_physics/layer_5="EnemyHitbox"
2d_physics/layer_6="Collectable"
2d_physics/layer_7="Interactable"
2d_physics/layer_8="Hazard"
2d_physics/layer_9="Trigger"
2d_physics/layer_10="Special"

[global_group]

world="Geometria sólida da fase."
player="Corpo controlado; nesta etapa, somente a sonda de teste."
spawn_points="Pontos iniciais de posicionamento."
