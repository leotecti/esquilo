		{"type":"scene","title":"Tico e a Floresta das Nozes","background":VILLAGE,"actor_position":Vector2(0.50,0.66)},
		{"type":"camera","focus":Vector2(0.50,0.45),"zoom":1.05,"duration":0.9},
		{"type":"dialogue","speaker":"Uma aventura entre amigos","text":"Siga a trilha. Encontre comida. Ajude o bosque."}
	]
