		{"type":"dialogue","speaker":"Tico","portrait":"tico","text":"Eu aceito, Valda. Vou ajudar o vilarejo e todos os animais que encontrar!"},
		{"type":"event","id":"first_clue_received"},
		{"type":"camera","focus":Vector2(0.80,0.48),"zoom":1.07,"duration":1.0},
		{"type":"dialogue","speaker":"Valda","text":"Comece seguindo a trilha de nozes. Observe também as penas: elas indicarão caminhos importantes."},
