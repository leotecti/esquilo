		{"type":"camera","focus":Vector2(0.67,0.40),"zoom":1.10,"duration":0.85},
		{"type":"dialogue","speaker":"Valda","text":"Muito obrigada, pequeno explorador. Você interrompeu sua jornada para me ajudar."},
		{"type":"camera","focus":Vector2(0.34,0.58),"zoom":1.12,"duration":0.75},
